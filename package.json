{
  "name": "agency-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server for auditing client websites: page audits, structured data, crawler access, Core Web Vitals, crawls, answerability, Search Console and answer-engine visibility.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agency-mcp-server": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "record": "npm run build && node dist/record.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "node-html-parser": "^9.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
